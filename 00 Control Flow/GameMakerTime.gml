function GameMakerTime() constructor {
    
    static __ = (function () {
        self[$ "fixed_delta_time"] = game_get_speed(gamespeed_microseconds) * 0.000001;
        self[$ "fixed_unscaled_delta_time"] = game_get_speed(gamespeed_microseconds) * 0.000001;
    })();
    
}

